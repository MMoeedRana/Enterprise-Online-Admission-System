# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Next.js
/frontend/.next/
/frontend/out/
/frontend/build/

# Backend build output
/backend/dist/
backend/build/

# General build output
**/dist/
**/build/

# Testing and coverage
**/coverage/
**/test-results/
**/playwright-report/
**/.nyc_output/

# Runtime storage and uploaded files
/backend/storage/*
!/backend/storage/.gitkeep

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts

# Vercel
**/.vercel/

# IDE and editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Temporary files
*.tmp
*.temp
.cache/
.tmp/
