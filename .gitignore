
# ==========================================
# ADMITRA - Root Git Ignore
# Backend + Frontend
# ==========================================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Next.js
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Build output
**/dist/
**/build/

# Testing and coverage
**/coverage/
**/test-results/
**/playwright-report/
**/.nyc_output/

# Backend uploaded files and local storage
backend/storage/*
!backend/storage/.gitkeep

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log

# TypeScript
**/*.tsbuildinfo

# Next.js generated files
**/AGENTS.md

# Vercel
**/.vercel/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Temporary files and caches
*.tmp
*.temp
.cache/
.tmp/
