# ==========================================
# ADMITRA - Root Git Ignore
# Backend + Frontend
# Phase 5
# ==========================================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Next.js
**/.next/
**/out/
**/next-env.d.ts

# Build output
**/dist/
**/build/

# Testing and coverage
**/coverage/
**/e2e-report/
**/test-results/
**/playwright-report/
**/.nyc_output/

# Backend storage and uploaded files
backend/storage/*
!backend/storage/.gitkeep

# Backups and database dumps
**/backups/
**/*.bak
**/*.backup
**/*.dump

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log

# TypeScript
**/*.tsbuildinfo

# Generated files
**/AGENTS.md

# Vercel
**/.vercel/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Certificates and private keys
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Temporary files and caches
**/.cache/
**/.tmp/
**/*.tmp
**/*.temp